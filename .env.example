# ==============================================================================
# Zero-Trust AI Agent Security Gateway Environment Configuration Template
# Copy this file to .env and configure values before starting the application.
# ==============================================================================

# Core Application Environment ('development', 'staging', 'production')
ENVIRONMENT=development
APP_NAME="Zero-Trust AI Runtime Gateway"
DEBUG=false

# Persistence Layer Configuration
# Local SQLite default: sqlite:///./gateway.db
# Production PostgreSQL example: postgresql+psycopg2://gateway_user:password@localhost:5432/zero_trust_gateway
DATABASE_URL=sqlite:///./gateway.db
DATABASE_ECHO=false

# PostgreSQL Credentials (used by Docker Compose)
POSTGRES_USER=gateway_user
POSTGRES_PASSWORD=ChangeMeInProduction_PostgresSecret2026!
POSTGRES_DB=zero_trust_gateway

# Cryptography & Token Secrets (MUST be at least 32 characters in production)
SECRET_KEY=insecure-dev-secret-key-change-in-production-min32chars!
WORKLOAD_SIGNING_SECRET=insecure-dev-workload-secret-key-change-in-production-min32chars!
AUDIT_CHAIN_SALT=insecure-dev-audit-salt-change-in-production-min32chars!
GATEWAY_AGENT_TOKEN=dev-agent-token-change-me

# Open Policy Agent (OPA) Integration
OPA_URL=http://127.0.0.1:8181/v1/data/ai_gateway/allow
OPA_TIMEOUT_SECONDS=0.5
# In production, OPA_FAIL_CLOSED is automatically enforced True
OPA_FAIL_CLOSED=0

# Outbound HTTP & SSRF Defenses
ALLOWED_OUTBOUND_DOMAINS=["api.weather.example","api.github.com","httpbin.org"]
OUTBOUND_HTTP_TIMEOUT_SECONDS=3.0
OUTBOUND_MAX_RESPONSE_BYTES=524288

# Rate Limiting
RATE_LIMIT_PER_MINUTE=120

# Frontend Integration
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
